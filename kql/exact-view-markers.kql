// Open Logs on the intended Application Insights resource, not its workspace.
// Use a resource dedicated to the intended Dataverse org; choose a bounded window.
// Validate customDimensions.viewId and pageViews.user_Id semantics before use.
let StartUtc = ago(7d);
let EndUtc = now();
let ScopedOperations =
    dependencies
    | where timestamp between (StartUtc .. EndUtc)
    | distinct operation_Id;
pageViews
| where timestamp between (StartUtc .. EndUtc)
| where operation_Id in (ScopedOperations)
| extend ViewId = toguid(tostring(customDimensions.viewId)), ActorId = toguid(user_Id),
    EntityName = tostring(customDimensions.entityName)
| where isnotnull(ViewId) and isnotnull(ActorId)
| summarize SampleCount = count(), P95Ms = percentile(duration, 95)
    by ActorId, ViewId, EntityName
| project SchemaVersion = 1,
    UserId = tostring(ActorId), UserIdType = "DataverseSystemUserId",
    ViewId = tostring(ViewId), Attribution = "ExactViewMarker", EntityName,
    WindowStartUtc = strcat(format_datetime(StartUtc, "yyyy-MM-dd"), "T",
        format_datetime(StartUtc, "HH:mm:ss.fff"), "Z"),
    WindowEndUtc = strcat(format_datetime(EndUtc, "yyyy-MM-dd"), "T",
        format_datetime(EndUtc, "HH:mm:ss.fff"), "Z"),
    SampleCount, P95Ms, MetricKind = "PageLoad"
| order by P95Ms desc
