// Replace every placeholder. Run in the linked Log Analytics workspace.
// Validate Properties.viewId and AppPageViews.UserId semantics before use.
let StartUtc = ago(7d);
let EndUtc = now();
let TargetOrganization = "REPLACE_WITH_DATAVERSE_ORGANIZATION_GUID";
let AppResourceId = "REPLACE_WITH_APPLICATION_INSIGHTS_RESOURCE_ID";
let ScopedOperations =
    AppDependencies
    | where TimeGenerated between (StartUtc .. EndUtc)
    | where _ResourceId =~ AppResourceId
    | where tostring(Properties.organizationId) =~ TargetOrganization
    | distinct OperationId;
AppPageViews
| where TimeGenerated between (StartUtc .. EndUtc)
| where _ResourceId =~ AppResourceId
| where OperationId in (ScopedOperations)
| extend ViewId = toguid(tostring(Properties.viewId)), ActorId = toguid(UserId),
    EntityName = tostring(Properties.entityName)
| where isnotnull(ViewId) and isnotnull(ActorId)
| summarize SampleCount = count(), P95Ms = percentile(DurationMs, 95)
    by ActorId, ViewId, EntityName
| project SchemaVersion = 1, OrganizationId = TargetOrganization,
    UserId = tostring(ActorId), UserIdType = "DataverseSystemUserId",
    ViewId = tostring(ViewId), Attribution = "ExactViewMarker", EntityName,
    WindowStartUtc = format_datetime(StartUtc, "yyyy-MM-ddTHH:mm:ss.fffZ"),
    WindowEndUtc = format_datetime(EndUtc, "yyyy-MM-ddTHH:mm:ss.fffZ"),
    SampleCount, P95Ms, MetricKind = "PageLoad"
| order by P95Ms desc
