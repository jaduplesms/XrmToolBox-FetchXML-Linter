// User/table candidates only: no saved-view attribution.
// Validate AppRequests.UserId is an Entra object ID in this export.
let StartUtc = ago(7d);
let EndUtc = now();
let TargetOrganization = "REPLACE_WITH_DATAVERSE_ORGANIZATION_GUID";
let AppResourceId = "REPLACE_WITH_APPLICATION_INSIGHTS_RESOURCE_ID";
let SdkRetrievals =
    AppDependencies
    | where TimeGenerated between (StartUtc .. EndUtc)
    | where _ResourceId =~ AppResourceId
    | where tostring(Properties.organizationId) =~ TargetOrganization
    | where DependencyType == "SDKRetrieveMultiple"
    | extend EntityName = tostring(Properties.entityName)
    | where isnotempty(EntityName)
    | distinct OperationId, ServerId = ParentId, EntityName;
AppRequests
| where TimeGenerated between (StartUtc .. EndUtc)
| where _ResourceId =~ AppResourceId
| project OperationId, ServerId = Id, UserId, DurationMs
| join kind=inner SdkRetrievals on OperationId, ServerId
| extend ActorId = toguid(UserId)
| where isnotnull(ActorId)
| summarize DurationMs = max(DurationMs) by OperationId, ServerId, ActorId, EntityName
| summarize SampleCount = count(), P95Ms = percentile(DurationMs, 95)
    by ActorId, EntityName
| project SchemaVersion = 1, OrganizationId = TargetOrganization,
    UserId = tostring(ActorId), UserIdType = "EntraObjectId",
    ViewId = "", Attribution = "UserTableCandidate", EntityName,
    WindowStartUtc = format_datetime(StartUtc, "yyyy-MM-ddTHH:mm:ss.fffZ"),
    WindowEndUtc = format_datetime(EndUtc, "yyyy-MM-ddTHH:mm:ss.fffZ"),
    SampleCount, P95Ms, MetricKind = "ServerRequest"
| order by P95Ms desc
