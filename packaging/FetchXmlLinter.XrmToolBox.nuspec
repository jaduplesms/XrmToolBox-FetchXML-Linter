<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>FetchXmlLinter.XrmToolBox</id>
    <version>$version$</version>
    <title>FetchXML Linter</title>
    <authors>jaduplesms</authors>
    <license type="expression">MIT</license>
    <readme>docs/README.md</readme>
    <icon>assets/icon-80.png</icon>
    <iconUrl>https://raw.githubusercontent.com/jaduplesms/XrmToolBox-FetchXML-Linter/main/assets/icon-80.png</iconUrl>
    <projectUrl>https://github.com/jaduplesms/XrmToolBox-FetchXML-Linter</projectUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Read-only FetchXML analysis for Microsoft Dataverse in XrmToolBox. Review supplied queries, personal views and mobile offline-profile filters with evidence, coverage limitations and links to Microsoft guidance. Early public preview; not a performance benchmark or automatic optimizer.</description>
    <releaseNotes>First public-preview candidate. Includes 29 selectable analysis rules; multi-user personal-view collection with verified impersonation and owner-aware results; optional Application Insights CSV shortlists; configured offline-filter analysis and generated-definition inspection; local XML formatting; and JSON/CSV reports. Does not execute saved queries or modify views or profiles.</releaseNotes>
    <tags>XrmToolBox FetchXML Linter Dataverse PersonalViews OfflineProfiles</tags>
    <dependencies>
      <group targetFramework="net48">
        <dependency id="XrmToolBox" version="1.2025.10.74" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="src\FetchXmlLinter.XrmToolBox\bin\$configuration$\net48\plugin\FetchXmlLinter.XrmToolBox.dll" target="lib\net48\Plugins" />
    <file src="README.md" target="docs" />
    <file src="LICENSE" target="docs\LICENSE" />
    <file src="THIRD-PARTY-NOTICES.md" target="docs" />
    <file src="assets\icon-80.png" target="assets" />
  </files>
</package>
